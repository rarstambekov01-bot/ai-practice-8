
from sklearn.linear_model import LinearRegression

# Количество посетителей столовой
X = [[100], [150], [200], [250], [300]]

# Сколько обедов было продано
y = [29, 41, 53, 66, 78]

# Создаём модель линейной регрессии
model = LinearRegression()

# Обучаем модель на прошлых данных
model.fit(X, y)

# Предсказываем продажи при 180 посетителях
result = model.predict([[180]])

# Выводим результат
print("Прогноз обедов:", round(result[0]))
